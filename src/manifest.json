{
  "name": "Fağır",
  "description": "Strip the malice off of the modern web and make it fağır again.",
  "homepage_url": "https://github.com/rvfet/fagir",
  "manifest_version": 2,
  "version": "1.1.0",

  "author": "Rafet Abbasli",
  "developer": {
    "name": "rvfet",
    "url": "https://rvfet.com"
  },

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["rules.js", "background.js"]
  },

  "browser_action": {
    "default_title": "Fağır",
    "default_popup": "popup.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "fagir@local"
    }
  }
}